NODE_ENV=development
PORT=5000

# Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expense_tracker

# Auth
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CLIENT_ORIGIN=http://localhost:5173

# Google OAuth (optional, Phase 3+)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (optional, for receipt uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
